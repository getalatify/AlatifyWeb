# Alatify server-side environment variables (names only).
# These are read ONLY in server-side route handlers / server config.
# NEVER prefix any of these with NEXT_PUBLIC_ — Next.js inlines every
# NEXT_PUBLIC_* value into the client JavaScript bundle at build time,
# which would publish the secret to every visitor's browser.

# Unsplash API access key (server-only).
# Used by: src/app/api/stock-search/route.ts, src/app/api/stock-download-trigger/route.ts
UNSPLASH_ACCESS_KEY=

# Pexels API key (server-only).
# Used by: src/app/api/stock-search/route.ts
PEXELS_API_KEY=

# Pixabay API key (server-only).
# Used by: src/app/api/stock-search/route.ts
PIXABAY_API_KEY=

# Optional. When set to "true", allows localhost/private targets in the
# fetch-image SSRF allowlist for local testing only.
# Used by: src/app/api/fetch-image/route.ts
ALATIFY_TEST=
